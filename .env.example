# ==============================================================================
# heb-mcp.skill (TikTok-2-HEB) Configuration Template
# Copy this file to .env and populate with your credentials/preferences.
# ==============================================================================

# H-E-B Store Configuration
# e.g., '639' for Mueller H-E-B (Corporate #639, 1801 E. 51st Street, Austin, TX 78723-3014), '390' for S Congress/Oltorf, etc.
HEB_STORE_ID=639

# H-E-B Account Credentials (Optional - used for session/cart automation)
HEB_USERNAME=
HEB_PASSWORD=

# LLM & Multimodal Extraction
# Used for recipe structuring, ingredient parsing, and audio/vision fallback
GEMINI_API_KEY=

# Automation Runtime Settings
PLAYWRIGHT_HEADLESS=true
